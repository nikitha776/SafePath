{
  "name": "safepath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "npm --prefix frontend run build",
    "test": "backend/.venv/bin/python -m pytest -q",
    "db:migrate": "backend/.venv/bin/alembic -c backend/alembic.ini upgrade head",
    "db:import-osm": "PYTHONPATH=backend backend/.venv/bin/python scripts/import_osm.py",
    "db:verify": "PYTHONPATH=backend backend/.venv/bin/python scripts/verify_database.py",
    "test:services": "backend/.venv/bin/python scripts/verify_services.py",
    "mobile": "npm --prefix mobile start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:check": "npm --prefix mobile run typecheck && npm --prefix mobile run lint"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
